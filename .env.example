# Скопируйте этот файл в .env и подставьте свои значения.
# .env не коммитится (см. .gitignore).

SERVER_PORT=8081

# Должен совпадать со значением JWT_SECRET в .env сервиса apigateway —
# apigateway форвардит исходный JWT как есть (Authorization: Bearer ...),
# сам его не разбирает, поэтому credit-service (как и loan-management-service)
# проверяет токен и достаёт из него личность пользователя самостоятельно.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_BASE64_SECRET_AT_LEAST_32_BYTES

# Адрес loan-management-service и общий секрет для вызова его внутреннего эндпоинта выдачи
# кредита при одобрении заявки. INTERNAL_API_KEY должен совпадать со значением в .env
# сервиса loan-management-service.
LOAN_MANAGEMENT_URL=http://localhost:8082
INTERNAL_API_KEY=REPLACE_WITH_AN_INTERNAL_SERVICE_SECRET

# Используются только при активном профиле prod (spring.profiles.active=prod);
# в dev-профиле по умолчанию используется встроенная H2.
DB_URL=jdbc:postgresql://localhost:5432/credit_operations
DB_USERNAME=postgres
DB_PASSWORD=postgres

# SMTP для уведомлений клиента об изменении статуса заявки.
# Без реальных значений сервис стартует нормально, ошибка будет только
# при попытке отправить письмо (PATCH .../status).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
